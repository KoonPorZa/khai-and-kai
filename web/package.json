{
  "name": "web",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "vite preview",
    "sync-art": "node scripts/sync-art.mjs",
    "render:hatch": "node hatch-film/build.mjs && cd hatch-film && hyperframes render -o ../public/art/hatch.mp4",
    "lint:hatch": "node hatch-film/build.mjs && cd hatch-film && hyperframes lint",
    "deploy": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm scan:dist && pnpm exec wrangler deploy",
    "scan:dist": "node scripts/scan-dist.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/noto-sans-thai": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@tanstack/react-query": "^5.108.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "viem": "^2.58.6",
    "wagmi": "^2.19.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "gsap": "^3.15.1",
    "hyperframes": "^0.9.92",
    "jsdom": "^31.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "4.152.0"
  }
}
